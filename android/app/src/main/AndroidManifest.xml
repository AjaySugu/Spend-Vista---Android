<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Required Permissions ── -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>  <!-- Android 13+ -->
    <!-- NOTE: READ_SMS is intentionally NOT requested. We use NotificationListenerService
         instead, which is Play-store-permitted for expense-tracking apps under the
         Prominent Disclosure policy. -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ── Main Activity ── -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep Link -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"
                    android:host="stageapp.spendvista.com"/>
            </intent-filter>
        </activity>

        <!-- ── Bank Notification Listener ──────────────────────────────────────
             Listens to notifications from known bank / payment apps and forwards
             parsed transaction data to the SpendVista backend.

             PLAY STORE REQUIREMENT: You MUST show a "Prominent Disclosure" screen
             inside the app BEFORE directing the user to grant this permission.
             The disclosure must explain:
               • What data is collected (notification content from bank apps)
               • Why (to auto-detect transactions for expense tracking)
               • Where it goes (your SpendVista server)
             See src/index.html for the in-app disclosure UI implementation.
        ─────────────────────────────────────────────────────────────────────── -->
        <service
            android:name=".BankNotificationService"
            android:label="SpendVista Transaction Detector"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
            <!-- meta-data required on Android 14+ -->
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting"/>
        </service>

        <!-- ── Firebase / Capacitor Push Notifications ── -->
        <service
            android:name="com.getcapacitor.plugin.PushNotificationsService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- ── FileProvider ── -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

    </application>

</manifest>
